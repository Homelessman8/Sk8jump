org.gradle.jvmargs=-Xmx**JVM_HEAP_SIZE**M
org.gradle.parallel=true
unityStreamingAssets=**STREAMING_ASSETS**
**ADDITIONAL_PROPERTIES**
# Fixes the compileSdk 36 warning
android.suppressUnsupportedCompileSdk=36

# If you need to stop the uncompressed native libs warning without changing build.gradle:
# Just ensure 'android.bundle.enableUncompressedNativeLibs=false' is NOT present in this file.
